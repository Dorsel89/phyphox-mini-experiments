<phyphox version="1.20" locale="en">
    <title>Temperature, Humidity</title>
    <category>phyphox:mini raw sensor</category>
    <color>ADEBB3</color>
    <description>Measure temperature and humidity measured by the HDC1080.</description>
    <translations>
        <translation locale="de">
            <title>Temperatur, Feuchtigkeit</title>
            <category>phyphox:mini Sensoren</category>
            <description>Messe Temperatur und relative Luftfeuchtigkeit mit dem HDC1080.</description>
            <string original="Rawdata">Rohdaten</string>
            <string original="Settings">Einstellungen</string>
            <string original="Temperature">Temperatur</string>
            <string original="Relative humidity">Relative Luftfeuchtigkeit</string>
            <string original="current measurement interval">aktuelles Messintervall</string>
            <string original="100ms">100 ms</string>
            <string original="500ms">500 ms</string>
            <string original="1s">1 s</string>
            <string original="2s">2 s</string>
        </translation>
    </translations>

    <data-containers>
        <container size="0">time_raw</container>
        <container size="1">timeOffset</container>
		<container size="0">time</container>

        <container size="0">temperature</container>
        <container size="0">humidity</container>
		
		<container size="1">count</container>
		<container size="1">first</container>
		<container size="1">rate</container>

        <container size="1" init="1" clearGroup="_">enable</container>
        <container size="1" init="3" clearGroup="_">interval</container>

    </data-containers>
    <input>
        <bluetooth id="phyphox:mini" name="phyphox:mini" mode="notification" subscribeOnStart="true">
            <config char="cddf1006-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">010A</config>
            <output char="cddf1005-30f7-4671-8b43-5e40ba53514a" offset="0" conversion="float32LittleEndian">temperature</output>
            <output char="cddf1005-30f7-4671-8b43-5e40ba53514a" offset="4" conversion="float32LittleEndian">humidity</output>
            <output char="cddf1005-30f7-4671-8b43-5e40ba53514a" offset="8" conversion="float32LittleEndian">time_raw</output>
        </bluetooth>
    </input>       
    <output>
        <bluetooth id="phyphox:mini">
            <input keep="true" char="cddf1006-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="0" triggerId="setConfig">enable</input>
            <input keep="true" char="cddf1006-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="1" triggerId="setConfig">interval</input>
        </bluetooth>
    </output>
    <views>
        <view label="Rawdata">
            <graph label="Temperature" timeOnX="true" labelX="time" unitX="s" labelY="T" unitY="°C" partialUpdate="true">
                <input axis="x">time</input>
                <input axis="y">temperature</input>                
            </graph>
            <value label="Temperature" unit="°C" size="1" precision="1" scientific="false" factor="1" >
                <input>temperature</input>
            </value> 

            <graph label="Relative humidity" timeOnX="true" labelX="time" unitX="s" labelY="RH" unitY="%" partialUpdate="true">
                <input axis="x">time</input>
                <input axis="y">humidity</input>                
            </graph>
            <value label="RH" unit="%" size="1" precision="1" scientific="false" factor="1" >
                <input>humidity</input>
            </value> 
        </view>

        <view label="Settings">
        
			<dropdown label="measurement interval" default="1">
				<output>interval</output>
				<map value="1">100ms</map>
				<map value="5">500ms</map>
				<map value="10">1s</map>
				<map value="20">2s</map>
			</dropdown>	
  
            <button label="set configuration">
                <trigger>setConfig</trigger>
            </button>  

                                     
        </view>      
    </views>
    <analysis sleep="0" onUserInput="false">
		<first>
            <input as="value" clear="false">time_raw</input>
            <output as="first">timeOffset</output>
        </first>
		<subtract>
            <input as="minuend" clear="false">time_raw</input>
            <input as="subtrahend" clear="false">timeOffset</input>
            <output as="difference">time</output>			
        </subtract>
        <count>
            <input as="buffer" clear="false">temperature</input>
            <output as="count">count</output>
        </count>
        <formula formula="[2]/([1])">
            <input as="in" clear="false">time</input>
            <input as="in" clear="false">count</input>
            <output as="out">rate</output>
        </formula>

    </analysis>
    <export>
        <set name="Raw data">
            <data name="Time (s)">time</data>
            <data name="Temperature (°C)">temperature</data>
			<data name="rel Humidity (%)">humidity</data>
        </set>
    </export>
</phyphox>
