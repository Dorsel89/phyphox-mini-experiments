<phyphox version="1.20" locale="en">
    <title>Set Device Name</title>
    <category>phyphox:mini</category>
    <color>ADEBB3</color>
    <description>Sets a custom 4-character Bluetooth advertising name ("phyphox:mini XXXX") on the connected phyphox:mini. The board restarts automatically right after applying the new name.</description>

    <translations>
        <translation locale="de">
            <title>Gerätename festlegen</title>
            <description>Legt einen benutzerdefinierten, 4-stelligen Bluetooth-Namen ("phyphox:mini XXXX") auf dem verbundenen phyphox:mini fest. Das Board startet nach dem Übernehmen automatisch neu.</description>
            <string original="Set device name (Letters &amp; Digits)">Gerätename festlegen (Buchstaben &amp; Ziffern)</string>
            <string original="Set device name (Full ASCII)">Gerätename festlegen (voller ASCII-Bereich)</string>
            <string original="Choose 4 characters. The device name will be 'phyphox:mini XXXX'. After applying, the board restarts immediately and disconnects.">Wähle 4 Zeichen. Der Gerätename wird 'phyphox:mini XXXX' lauten. Nach dem Übernehmen startet das Board sofort neu und trennt die Verbindung.</string>
            <string original="Choose any of the 256 byte values as characters. Non-printable/extended values are shown as their hex code and may not display correctly everywhere.">Wähle einen beliebigen der 256 Byte-Werte als Zeichen. Nicht druckbare/erweiterte Werte werden als Hex-Code angezeigt und werden eventuell nicht überall korrekt dargestellt.</string>
            <string original="1st character">1. Zeichen</string>
            <string original="2nd character">2. Zeichen</string>
            <string original="3rd character">3. Zeichen</string>
            <string original="4th character">4. Zeichen</string>
            <string original="Apply name (board will restart)">Namen übernehmen (Board startet neu)</string>
            <string original="Reset to factory default name">Auf Werksnamen zurücksetzen</string>
        </translation>
    </translations>

    <data-containers>
        <container size="1" static="false" init="0">unused</container>

        <container size="1" static="false" init="2">cmd_out</container>
        <container size="1" static="false" init="78">char1_code</container>
        <container size="1" static="false" init="65">char2_code</container>
        <container size="1" static="false" init="77">char3_code</container>
        <container size="1" static="false" init="69">char4_code</container>
    </data-containers>

    <input>
    </input>
    <output>
        <bluetooth id="phyphox:mini" name="phyphox:mini">
            <input keep="false" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="0" triggerId="setName">cmd_out</input>
            <input keep="false" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="1" triggerId="setName">char4_code</input>
            <input keep="false" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="2" triggerId="setName">char3_code</input>
            <input keep="false" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="3" triggerId="setName">char2_code</input>
            <input keep="false" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="4" triggerId="setName">char1_code</input>
        </bluetooth>
    </output>

    <views>
        <view label="Set device name (Letters &amp; Digits)">
            <info label="Choose 4 characters. The device name will be 'phyphox:mini XXXX'. After applying, the board restarts immediately and disconnects."/>

            <dropdown label="1st character" default="78">
                <output>char1_code</output>
                <map value="65">A</map>
                <map value="66">B</map>
                <map value="67">C</map>
                <map value="68">D</map>
                <map value="69">E</map>
                <map value="70">F</map>
