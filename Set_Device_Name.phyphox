<phyphox version="1.20" locale="en">
    <title>Set Device Name</title>
    <category>phyphox:mini settings</category>
    <color>ADEBB3</color>
    <icon format="base64"></icon>
    <description>Sets a custom 4-character Bluetooth name ("phyphox:mini XXXX") on the connected phyphox:mini. The name is stored on the phyphox:mini and shows up in the Bluetooth search after disconnecting. Requires firmware 2.0 or newer.</description>

    <translations>
        <translation locale="de">
            <title>Gerätename festlegen</title>
            <category>phyphox:mini Einstellungen</category>
            <description>Legt einen eigenen, 4-stelligen Bluetooth-Namen ("phyphox:mini XXXX") auf dem verbundenen phyphox:mini fest. Der Name wird auf dem phyphox:mini gespeichert und erscheint nach dem Trennen in der Bluetooth-Suche. Benötigt Firmware 2.0 oder neuer.</description>
            <string original="Set device name (letters &amp; digits)">Gerätename festlegen (Buchstaben &amp; Ziffern)</string>
            <string original="Set device name (all characters)">Gerätename festlegen (alle Zeichen)</string>
            <string original="Choose 4 characters. The device name will be 'phyphox:mini XXXX'. Start the measurement (▶) first, then tap 'Apply name'. The phyphox:mini stays connected; the new name shows up in the Bluetooth search as soon as you leave this experiment.">Wähle 4 Zeichen. Der Gerätename lautet dann 'phyphox:mini XXXX'. Starte zuerst die Messung (▶) und tippe dann auf 'Namen übernehmen'. Der phyphox:mini bleibt verbunden; der neue Name erscheint in der Bluetooth-Suche, sobald du dieses Experiment verlässt.</string>
            <string original="Same as the first tab, but with all printable ASCII characters (lower case, punctuation). Both tabs set the same 4 characters.">Wie der erste Reiter, aber mit allen druckbaren ASCII-Zeichen (Kleinbuchstaben, Satzzeichen). Beide Reiter stellen dieselben 4 Zeichen ein.</string>
            <string original="'Reset to factory default name' removes the custom name. The phyphox:mini then uses the name it was delivered with again (letter and number, e.g. A19).">'Auf Werksnamen zurücksetzen' entfernt den eigenen Namen. Der phyphox:mini verwendet dann wieder den Namen, mit dem er ausgeliefert wurde (Buchstabe und Nummer, z. B. A19).</string>
            <string original="1st character">1. Zeichen</string>
            <string original="2nd character">2. Zeichen</string>
            <string original="3rd character">3. Zeichen</string>
            <string original="4th character">4. Zeichen</string>
            <string original="Space">Leerzeichen</string>
            <string original="Apply name">Namen übernehmen</string>
            <string original="Reset to factory default name">Auf Werksnamen zurücksetzen</string>
        </translation>
    </translations>

    <data-containers>
        <!-- The four characters, set by the dropdowns long before a button is pressed. -->
        <container size="1" static="false" init="78" clearGroup="_">char1_code</container>
        <container size="1" static="false" init="65" clearGroup="_">char2_code</container>
        <container size="1" static="false" init="77" clearGroup="_">char3_code</container>
        <container size="1" static="false" init="69" clearGroup="_">char4_code</container>

        <!-- Command 0x03 of the device settings (firmware v2): name in normal
             order. Fixed container, the buttons only trigger a send (a button
             that also writes the values it sends races the send in phyphox). -->
        <container size="1" static="true" init="3">cmd_name</container>
    </data-containers>

    <input>
    </input>
    <output>
        <bluetooth id="phyphox:mini" name="phyphox:mini">
            <!-- Apply: 03 c1 c2 c3 c4 -->
            <input keep="true" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="0" triggerId="setName">cmd_name</input>
            <input keep="true" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="1" triggerId="setName">char1_code</input>
            <input keep="true" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="2" triggerId="setName">char2_code</input>
            <input keep="true" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="3" triggerId="setName">char3_code</input>
            <input keep="true" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="4" triggerId="setName">char4_code</input>
            <!-- Reset: 03 without characters restores the default name -->
            <input keep="true" char="cddf1022-30f7-4671-8b43-5e40ba53514a" length="1" conversion="singleByte" offset="0" triggerId="resetName">cmd_name</input>
        </bluetooth>
    </output>

    <views>
        <view label="Set device name (letters &amp; digits)">
            <info label="Choose 4 characters. The device name will be 'phyphox:mini XXXX'. Start the measurement (▶) first, then tap 'Apply name'. The phyphox:mini stays connected; the new name shows up in the Bluetooth search as soon as you leave this experiment."/>

