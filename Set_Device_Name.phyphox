            <button label="Apply name (board will restart)">
                <input type="value">2</input>
                <output>cmd_out</output>
                <trigger>setName</trigger>
            </button>

            <button label="Reset to factory default name">
                <input type="value">2</input>
                <output>cmd_out</output>
                <input type="value">255</input>
                <output>char1_code</output>
                <input type="value">255</input>
                <output>char2_code</output>
                <input type="value">255</input>
                <output>char3_code</output>
                <input type="value">255</input>
                <output>char4_code</output>
                <trigger>setName</trigger>
            </button>
        </view>

