            <separator height="1" />
            <info label="'Reset to factory default name' removes the custom name. The phyphox:mini then uses the name it was delivered with again (letter and number, e.g. A19)."/>
            <button label="Reset to factory default name">
                <trigger>resetName</trigger>
            </button>
        </view>

