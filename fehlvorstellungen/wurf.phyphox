<?xml version="1.0" encoding="UTF-8"?>
<phyphox version="1.20" locale="de">
    <title>Was fühlt der Ball im Flug?</title>
    <category>phyphox:mini Fehlvorstellungen</category>
    <color>ADEBB3</color>
    <description>Vortest, Experiment mit dem phyphox:mini (Beschleunigungssensor beim senkrechten Wurf, Flugzeit und Steighöhe) und Nachtest zur Vorstellung „Ein geworfener Körper trägt die Kraft der Hand in sich“.</description>

    <data-containers>
        <!-- Messdaten und Auswertung -->
        <container size="0">t_raw</container>
        <container size="0">ax_raw</container>
        <container size="0">ay_raw</container>
        <container size="0">az_raw</container>
        <container size="0">ta</container>
        <container size="0">ax</container>
        <container size="0">ay</container>
        <container size="0">az</container>
        <container size="0">a_new</container>
        <container size="0">a_abs</container>
        <container size="0">a_free</container>
        <container size="1">n_free</container>
        <container size="1">n_all</container>
        <container size="1">ta_first</container>
        <container size="1">ta_last</container>
        <container size="1">dt_s</container>
        <container size="1">t_free</container>
        <container size="1">a_free_avg</container>
        <container size="1">h_wurf</container>

        <!-- Vortest -->
        <container size="1" clearGroup="Antworten Vortest">pre_kraefte</container>
        <container size="1" clearGroup="Antworten Vortest">pre_kraefte_sicher</container>
        <container size="1" clearGroup="Antworten Vortest">pre_oben</container>
        <container size="1" clearGroup="Antworten Vortest">pre_oben_sicher</container>
        <container size="1" clearGroup="Antworten Vortest">pre_hand</container>

        <!-- Vorhersage und Nachtest -->
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">vorhersage</container>
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">post_kraefte</container>
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">post_kraefte_sicher</container>
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">post_oben</container>
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">post_oben_sicher</container>
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">post_hand</container>
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">post_golf</container>
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">post_erklaerung</container>

        <!-- Steuerung der Anzeige (visibility) -->
        <container size="1">vorhersage_offen</container>
        <container size="1">pre_offen</container>
        <container size="1">post_offen</container>

        <!-- Phase und Rückmeldung des Servers -->
        <container size="1" init="1" clearGroup="_">phase_pre</container>
        <container size="1" init="2" clearGroup="_">phase_post</container>
        <container size="1" clearGroup="Antworten Vortest">rx_pre_stored</container>
        <container size="1" clearGroup="Antworten Vortest">rx_pre_total</container>
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">rx_post_stored</container>
        <container size="1" clearGroup="Vorhersage und Antworten Nachtest">rx_post_total</container>
    </data-containers>

    <input>
        <bluetooth id="mini" name="phyphox:mini" mode="notification" mtu="247" subscribeOnStart="true">
            <!-- LSM6DSR: enable=1 (1 Beschl., 3 beides), 208 Hz, Bereich-Code 1, Drehraten-Code 0, float, 15 Werte/Paket -->
            <config char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">01050100000F</config>
            <output char="cddf1001-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0" repeating="16">t_raw</output>
            <output char="cddf1001-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4" repeating="16">ax_raw</output>
            <output char="cddf1001-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8" repeating="16">ay_raw</output>
            <output char="cddf1001-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12" repeating="16">az_raw</output>
        </bluetooth>
    </input>

    <analysis>
        <formula formula="sqrt([1_]^2+[2_]^2+[3_]^2)">
            <input keep="true">ax_raw</input>
            <input keep="true">ay_raw</input>
            <input keep="true">az_raw</input>
            <output>a_new</output>
        </formula>
        <append>
            <input keep="true">a_new</input>
            <output append="true">a_abs</output>
        </append>
        <append>
            <input keep="false">t_raw</input>
            <output append="true">ta</output>
        </append>
        <append>
            <input keep="false">ax_raw</input>
            <output append="true">ax</output>
        </append>
        <append>
            <input keep="false">ay_raw</input>
            <output append="true">ay</output>
        </append>
        <append>
            <input keep="false">az_raw</input>
            <output append="true">az</output>
        </append>
        <rangefilter>
            <input keep="true">a_abs</input>
            <input as="min" type="value">0</input>
            <input as="max" type="value">2.5</input>
            <output>a_free</output>
        </rangefilter>
        <count>
            <input as="buffer" keep="true">a_free</input>
            <output as="count">n_free</output>
        </count>
        <count>
            <input as="buffer" keep="true">ta</input>
            <output as="count">n_all</output>
        </count>
        <first>
            <input as="value" keep="true">ta</input>
            <output as="first">ta_first</output>
        </first>
        <append>
            <input keep="true">ta</input>
            <output>ta_last</output>
        </append>
        <formula formula="([3]-[2])/([4]-1)">
            <input keep="true">n_free</input>
            <input keep="true">ta_first</input>
            <input keep="true">ta_last</input>
            <input keep="true">n_all</input>
            <output>dt_s</output>
        </formula>
        <formula formula="[1]*[2]">
            <input keep="true">n_free</input>
            <input keep="true">dt_s</input>
            <output>t_free</output>
        </formula>
        <average>
            <input as="buffer" keep="true">a_free</input>
            <output as="average">a_free_avg</output>
        </average>
        <formula formula="9.81*[1]^2/8">
            <input keep="true">t_free</input>
            <output>h_wurf</output>
        </formula>
        <!-- Anzeige steuern: offene Vorhersage und unbeantwortete Fragen -->
        <formula formula="1-sign([1])">
            <input keep="true">vorhersage</input>
            <output>vorhersage_offen</output>
        </formula>
        <formula formula="(1-sign([1]))+(1-sign([2]))+(1-sign([3]))+(1-sign([4]))">
            <input keep="true">pre_kraefte</input>
            <input keep="true">pre_kraefte_sicher</input>
            <input keep="true">pre_oben</input>
            <input keep="true">pre_oben_sicher</input>
            <output>pre_offen</output>
        </formula>
        <formula formula="(1-sign([1]))+(1-sign([2]))+(1-sign([3]))+(1-sign([4]))+(1-sign([5]))+(1-sign([6]))">
            <input keep="true">post_kraefte</input>
            <input keep="true">post_kraefte_sicher</input>
            <input keep="true">post_oben</input>
            <input keep="true">post_oben_sicher</input>
            <input keep="true">post_golf</input>
            <input keep="true">post_erklaerung</input>
            <output>post_offen</output>
        </formula>
    </analysis>

    <views>
        <!-- BEGIN HINTERGRUND: für den Einsatz im Unterricht entfernen -->
        <view label="0 Hintergrund">
            <info label="Was fühlt der Ball im Flug? – Hintergrund für Lehrkräfte" bold="true" size="1.2" />
            <info label="Diese Seite ist nur für die Erprobung gedacht und wird für den Einsatz entfernt." italic="true" size="0.85" />
            <separator height="2" />
            <info label="Zweck" bold="true" />
            <info label="Der Sensor zeigt beim Abwurf einen großen Ausschlag, danach während des gesamten Flugs etwa 0 – ohne Unterschied zwischen Aufstieg, höchstem Punkt und Fall – und beim Fangen wieder einen Ausschlag. Die Hand wirkt nur, solange sie berührt. Im Flug wirkt nur die Schwerkraft, die ganze Zeit gleich. Die aus der Flugzeit berechnete Steighöhe (h = g·t²/8) zeigt, dass g die ganze Zeit wirkt." />
            <separator height="2" />
            <info label="Fehlvorstellung" bold="true" />
            <info label="„Ein bewegter Körper hat Kraft“ / gespeicherte Bewegungskraft, „Abschlagskraft“ (Schecker u. a. 2018, S. 72–73; Handout); „Zu einem Zeitpunkt kann keine Beschleunigung vorliegen“, im Umkehrpunkt wird keine Beschleunigung angegeben (S. 67)." />
            <separator height="2" />
            <info label="Physik" bold="true" />
            <info label="Der Sensor misst a − g. Im Flug ist a = g, also zeigt er 0 (bis auf Luftwiderstand und Drehung). Flugzeit und Steighöhe: t = 2·v₀/g, h = v₀²/(2g) = g·t²/8." />
            <separator height="2" />
            <info label="Auswertung" bold="true" />
            <info label="Die Flugzeit ist die Anzahl der Messwerte mit |a| unter 2,5 m/s² mal dem Abtastabstand (aus den Zeitstempeln, 208 Hz). Deshalb vor jedem Wurf „Neuer Wurf“ tippen. Kurzes Abheben beim Fangen zählt mit." />
            <separator height="2" />
            <info label="Hinweise" bold="true" />
            <info label="Riskantestes Experiment: Ohne die Einführung des Sensors (aus E08) entsteht die neue Fehlvorstellung „im Flug wirkt keine Schwerkraft“ – die Erklärungsfrage im Nachtest prüft genau das. Drall erzeugt Zusatzsignale (Zentripetalbeschleunigung des Sensors). Weich fangen, nicht auf harten Boden fallen lassen. Nach E08 einsetzen." />
            <separator height="2" />
            <info label="Antwortschlüssel" bold="true" />
            <info label="1. Ein Ball wird senkrecht hochgeworfen. Welche Kräfte wirken auf ihn, während er nach oben fliegt (ohne Luftwiderstand)?" italic="true" size="0.85" />
            <info label="1 = die Schwerkraft und eine Wurfkraft nach oben → Impetus / Kraft im Körper
            2 = nur die Schwerkraft → richtig
            3 = nur die Wurfkraft → Impetus" size="0.85" />
            <info label="2. Im höchsten Punkt seiner Bahn ist die Beschleunigung des Balls …" italic="true" size="0.85" />
            <info label="1 = null → keine Beschleunigung zu einem Zeitpunkt
            2 = 9,81 m/s² nach unten → richtig
            3 = kurz nach oben gerichtet → Impetus" size="0.85" />
            <info label="3. Ein geworfener Ball trägt die Kraft der Hand noch eine Weile in sich." italic="true" size="0.85" />
            <info label="Zustimmung (4–5) = Fehlvorstellung" size="0.85" />
            <info label="4 (nur Nachtest). Ein Golfball fliegt nach dem Abschlag durch die Luft. Welche Kräfte wirken im Flug (Luftwiderstand vernachlässigt)?" italic="true" size="0.85" />
            <info label="1 = die Abschlagskraft und die Schwerkraft → Impetus
            2 = nur die Schwerkraft → richtig
            3 = zuerst die Abschlagskraft, die nachlässt, dann die Schwerkraft → Impetus verbraucht sich" size="0.85" />
            <info label="5 (nur Nachtest). Warum zeigte der Sensor während des ganzen Flugs etwa 0?" italic="true" size="0.85" />
            <info label="1 = Im Flug wirkt keine Schwerkraft. → neue Fehlvorstellung: keine Schwerkraft im Flug
            2 = Nur die Schwerkraft wirkt – und die fühlt der Sensor nicht, weil ihn nichts berührt. → richtig
            3 = Wurfkraft und Schwerkraft heben sich auf. → Impetus" size="0.85" />
            <info label="Vorhersage im Experiment" italic="true" size="0.85" />
            <info label="1 = erst noch einen Wert, der langsam abnimmt, oben 0, danach wieder mehr → Impetus" size="0.85" />
            <info label="2 = während des ganzen Flugs etwa denselben Wert (etwa 0) → ERWARTET" size="0.85" />
            <info label="3 = nur im höchsten Punkt 0, sonst deutlich mehr → keine Beschleunigung im Umkehrpunkt" size="0.85" />
        </view>
        <!-- END HINTERGRUND -->

        <view label="1 Vortest">
            <info label="Was fühlt der Ball im Flug? – Vortest" bold="true" size="1.2" />
            <info label="Verbinde den phyphox:mini, lege ihn ruhig auf den Tisch und tippe oben rechts auf ▶. Beantworte dann die Fragen." />
            <info label="Wenn du die Messung über den Papierkorb löschst, bleiben deine Antworten erhalten, solange du sie im Dialog nicht mit auswählst." size="0.85" />
            <separator height="2" />
            <info label="1. Ein Ball wird senkrecht hochgeworfen. Welche Kräfte wirken auf ihn, während er nach oben fliegt (ohne Luftwiderstand)?" bold="true" />
            <dropdown default="0">
                <output>pre_kraefte</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">die Schwerkraft und eine Wurfkraft nach oben</map>
                <map value="2">nur die Schwerkraft</map>
                <map value="3">nur die Wurfkraft</map>
            </dropdown>
            <info label="Wie sicher bist du dir?" size="0.85" />
            <dropdown default="0">
                <output>pre_kraefte_sicher</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">geraten</map>
                <map value="2">eher unsicher</map>
                <map value="3">eher sicher</map>
                <map value="4">sehr sicher</map>
            </dropdown>
            <separator height="2" />
            <info label="2. Im höchsten Punkt seiner Bahn ist die Beschleunigung des Balls …" bold="true" />
            <dropdown default="0">
                <output>pre_oben</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">null</map>
                <map value="2">9,81 m/s² nach unten</map>
                <map value="3">kurz nach oben gerichtet</map>
            </dropdown>
            <info label="Wie sicher bist du dir?" size="0.85" />
            <dropdown default="0">
                <output>pre_oben_sicher</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">geraten</map>
                <map value="2">eher unsicher</map>
                <map value="3">eher sicher</map>
                <map value="4">sehr sicher</map>
            </dropdown>
            <separator height="2" />
            <info label="3. Ein geworfener Ball trägt die Kraft der Hand noch eine Weile in sich." bold="true" />
            <info label="1 = stimme nicht zu   …   5 = stimme zu" size="0.85" />
            <slider minValue="1" maxValue="5" stepSize="1" default="3" precision="0" showValue="false">
                <output>pre_hand</output>
            </slider>
            <value label="Deine Antwort" precision="2" visibility="pre_hand">
                <input>pre_hand</input>
                <map min="0.5" max="1.5">stimme nicht zu</map>
                <map min="1.5" max="2.5">stimme eher nicht zu</map>
                <map min="2.5" max="3.5">teils / teils</map>
                <map min="3.5" max="4.5">stimme eher zu</map>
                <map min="4.5" max="5.5">stimme zu</map>
            </value>
            <separator height="2" />
            <value label="Noch nicht beantwortet" precision="0" unit="Auswahlfelder" visibility="pre_offen" color="orange">
                <input>pre_offen</input>
            </value>
            <button label="Vortest absenden" dynamicLabel="rx_pre_stored">
                <map min="0.5">Vortest übertragen ✓ – erneut senden</map>
                <trigger>pretest</trigger>
            </button>
            <value label="Übertragene Antworten" precision="0" visibility="rx_pre_total">
                <input>rx_pre_stored</input>
            </value>
            <info label="Danach weiter zum Reiter „2 Experiment“." />
        </view>

        <view label="2 Experiment">
            <info label="Was fühlt der Ball im Flug? – Experiment" bold="true" size="1.2" />
            <info label="So funktioniert der Beschleunigungssensor: Er fühlt, wie stark er gerade geschoben, gehalten oder gezogen wird – also die Kraft der Unterlage, der Hand oder der Schnur (geteilt durch seine Masse). Die Schwerkraft selbst fühlt er nicht. Liegt er ruhig auf dem Tisch, zeigt er deshalb etwa 9,8 m/s², weil der Tisch ihn nach oben drückt." />
            <info label="Du brauchst ein Kissen oder eine weiche Decke zum Fangen. Wirf den mini nur senkrecht und ohne Drall, etwa 30–50 cm hoch, und fange ihn mit beiden Händen weich." />
            <separator height="2" />
            <info label="Schritt 1 – Vorhersage" bold="true" />
            <info label="Was zeigt der Sensor, nachdem er die Hand verlassen hat?" />
            <dropdown default="0">
                <output>vorhersage</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">erst noch einen Wert, der langsam abnimmt, oben 0, danach wieder mehr</map>
                <map value="2">während des ganzen Flugs etwa denselben Wert (etwa 0)</map>
                <map value="3">nur im höchsten Punkt 0, sonst deutlich mehr</map>
            </dropdown>
            <info label="Wähle zuerst deine Vorhersage. Danach erscheinen die nächsten Schritte." italic="true" visibility="vorhersage_offen" />
            <graph visibility="vorhersage" label="Betrag der gemessenen Beschleunigung" labelX="Zeit" unitX="s" labelY="|a|" unitY="m/s²" scaleMinY="fixed" scaleMaxY="fixed" minY="0" maxY="40" partialUpdate="false">
                <input axis="x">ta</input>
                <input axis="y">a_abs</input>
            </graph>
            <separator visibility="vorhersage" height="2" />
            <info visibility="vorhersage" label="Schritt 2 – Werfen" bold="true" />
            <info visibility="vorhersage" label="Tippe vor jedem Wurf auf „Neuer Wurf“. Halte den mini dann ruhig, wirf ihn hoch und fange ihn weich." />
            <button visibility="vorhersage" label="Neuer Wurf">
                <input type="empty"></input>
                <output>ta</output>
                <input type="empty"></input>
                <output>ax</output>
                <input type="empty"></input>
                <output>ay</output>
                <input type="empty"></input>
                <output>az</output>
                <input type="empty"></input>
                <output>a_abs</output>
            </button>
            <value visibility="vorhersage" label="Flugzeit (Sensor zeigt fast 0)" precision="3" unit="s" size="1.5">
                <input>t_free</input>
            </value>
            <value visibility="vorhersage" label="Mittlerer Wert während des Flugs" precision="2" unit="m/s²">
                <input>a_free_avg</input>
            </value>
            <value visibility="vorhersage" label="Steighöhe aus der Flugzeit" precision="2" unit="m">
                <input>h_wurf</input>
            </value>
            <separator visibility="vorhersage" height="2" />
            <info visibility="vorhersage" label="Schau dir die Kurve genau an: Gibt es einen Unterschied zwischen Aufstieg, höchstem Punkt und Fall? Die Steighöhe wurde allein aus der Flugzeit und g = 9,81 m/s² berechnet – passt sie zu deinem Wurf? Weiter zum Reiter „3 Nachtest“." />
        </view>

        <view label="3 Nachtest">
            <info label="Was fühlt der Ball im Flug? – Nachtest" bold="true" size="1.2" />
            <info label="Beantworte die Fragen jetzt noch einmal, nachdem du gemessen hast." />
            <separator height="2" />
            <info label="1. Ein Ball wird senkrecht hochgeworfen. Welche Kräfte wirken auf ihn, während er nach oben fliegt (ohne Luftwiderstand)?" bold="true" />
            <dropdown default="0">
                <output>post_kraefte</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">die Schwerkraft und eine Wurfkraft nach oben</map>
                <map value="2">nur die Schwerkraft</map>
                <map value="3">nur die Wurfkraft</map>
            </dropdown>
            <info label="Wie sicher bist du dir?" size="0.85" />
            <dropdown default="0">
                <output>post_kraefte_sicher</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">geraten</map>
                <map value="2">eher unsicher</map>
                <map value="3">eher sicher</map>
                <map value="4">sehr sicher</map>
            </dropdown>
            <separator height="2" />
            <info label="2. Im höchsten Punkt seiner Bahn ist die Beschleunigung des Balls …" bold="true" />
            <dropdown default="0">
                <output>post_oben</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">null</map>
                <map value="2">9,81 m/s² nach unten</map>
                <map value="3">kurz nach oben gerichtet</map>
            </dropdown>
            <info label="Wie sicher bist du dir?" size="0.85" />
            <dropdown default="0">
                <output>post_oben_sicher</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">geraten</map>
                <map value="2">eher unsicher</map>
                <map value="3">eher sicher</map>
                <map value="4">sehr sicher</map>
            </dropdown>
            <separator height="2" />
            <info label="3. Ein geworfener Ball trägt die Kraft der Hand noch eine Weile in sich." bold="true" />
            <info label="1 = stimme nicht zu   …   5 = stimme zu" size="0.85" />
            <slider minValue="1" maxValue="5" stepSize="1" default="3" precision="0" showValue="false">
                <output>post_hand</output>
            </slider>
            <value label="Deine Antwort" precision="2" visibility="post_hand">
                <input>post_hand</input>
                <map min="0.5" max="1.5">stimme nicht zu</map>
                <map min="1.5" max="2.5">stimme eher nicht zu</map>
                <map min="2.5" max="3.5">teils / teils</map>
                <map min="3.5" max="4.5">stimme eher zu</map>
                <map min="4.5" max="5.5">stimme zu</map>
            </value>
            <separator height="2" />
            <info label="4. Ein Golfball fliegt nach dem Abschlag durch die Luft. Welche Kräfte wirken im Flug (Luftwiderstand vernachlässigt)?" bold="true" />
            <dropdown default="0">
                <output>post_golf</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">die Abschlagskraft und die Schwerkraft</map>
                <map value="2">nur die Schwerkraft</map>
                <map value="3">zuerst die Abschlagskraft, die nachlässt, dann die Schwerkraft</map>
            </dropdown>
            <separator height="2" />
            <info label="5. Warum zeigte der Sensor während des ganzen Flugs etwa 0?" bold="true" />
            <dropdown default="0">
                <output>post_erklaerung</output>
                <map value="0">– bitte auswählen –</map>
                <map value="1">Im Flug wirkt keine Schwerkraft.</map>
                <map value="2">Nur die Schwerkraft wirkt – und die fühlt der Sensor nicht, weil ihn nichts berührt.</map>
                <map value="3">Wurfkraft und Schwerkraft heben sich auf.</map>
            </dropdown>
            <separator height="2" />
            <value label="Noch nicht beantwortet" precision="0" unit="Auswahlfelder" visibility="post_offen" color="orange">
                <input>post_offen</input>
            </value>
            <button label="Nachtest absenden" dynamicLabel="rx_post_stored">
                <map min="0.5">Nachtest übertragen ✓ – erneut senden</map>
                <trigger>posttest</trigger>
            </button>
            <value label="Übertragene Antworten" precision="0" visibility="rx_post_total">
                <input>rx_post_stored</input>
            </value>
            <value label="Rückmeldungen insgesamt" precision="0" visibility="rx_post_total">
                <input>rx_post_total</input>
            </value>
        </view>
    </views>

    <export>
        <set name="Messung">
            <data name="Zeit (s)">ta</data>
            <data name="a_x (m/s²)">ax</data>
            <data name="a_y (m/s²)">ay</data>
            <data name="a_z (m/s²)">az</data>
            <data name="|a| (m/s²)">a_abs</data>
        </set>
        <set name="Ergebnisse">
            <data name="Flugzeit (s)">t_free</data>
            <data name="Mittelwert im Flug (m/s2)">a_free_avg</data>
            <data name="Steighöhe (m)">h_wurf</data>
        </set>
        <set name="Antworten">
            <data name="pre_kraefte">pre_kraefte</data>
            <data name="pre_kraefte_sicher">pre_kraefte_sicher</data>
            <data name="pre_oben">pre_oben</data>
            <data name="pre_oben_sicher">pre_oben_sicher</data>
            <data name="pre_hand">pre_hand</data>
            <data name="vorhersage">vorhersage</data>
            <data name="post_kraefte">post_kraefte</data>
            <data name="post_kraefte_sicher">post_kraefte_sicher</data>
            <data name="post_oben">post_oben</data>
            <data name="post_oben_sicher">post_oben_sicher</data>
            <data name="post_hand">post_hand</data>
            <data name="post_golf">post_golf</data>
            <data name="post_erklaerung">post_erklaerung</data>
        </set>
    </export>

    <network>
        <connection id="pretest" privacy="https://didaktik.physik.rwth-aachen.de/phyphox/api/privacy.php#umfrage" address="https://didaktik.physik.rwth-aachen.de/phyphox/api/survey_ingest.php?survey=wurf" autoConnect="true" service="http/post" conversion="json">
            <send id="phase" type="buffer" keep="true">phase_pre</send>
            <send id="pre_kraefte" type="buffer" keep="true">pre_kraefte</send>
            <send id="pre_kraefte_sicher" type="buffer" keep="true">pre_kraefte_sicher</send>
            <send id="pre_oben" type="buffer" keep="true">pre_oben</send>
            <send id="pre_oben_sicher" type="buffer" keep="true">pre_oben_sicher</send>
            <send id="pre_hand" type="buffer" keep="true">pre_hand</send>
            <send id="client" type="meta">uniqueID</send>
            <send id="time" type="time" />
            <receive id="stored" append="false">rx_pre_stored</receive>
            <receive id="total" append="false">rx_pre_total</receive>
        </connection>
        <connection id="posttest" privacy="https://didaktik.physik.rwth-aachen.de/phyphox/api/privacy.php#umfrage" address="https://didaktik.physik.rwth-aachen.de/phyphox/api/survey_ingest.php?survey=wurf" autoConnect="true" service="http/post" conversion="json">
            <send id="phase" type="buffer" keep="true">phase_post</send>
            <send id="vorhersage" type="buffer" keep="true">vorhersage</send>
            <send id="t_free" type="buffer" keep="true">t_free</send>
            <send id="a_free_avg" type="buffer" keep="true">a_free_avg</send>
            <send id="h_wurf" type="buffer" keep="true">h_wurf</send>
            <send id="post_kraefte" type="buffer" keep="true">post_kraefte</send>
            <send id="post_kraefte_sicher" type="buffer" keep="true">post_kraefte_sicher</send>
            <send id="post_oben" type="buffer" keep="true">post_oben</send>
            <send id="post_oben_sicher" type="buffer" keep="true">post_oben_sicher</send>
            <send id="post_hand" type="buffer" keep="true">post_hand</send>
            <send id="post_golf" type="buffer" keep="true">post_golf</send>
            <send id="post_erklaerung" type="buffer" keep="true">post_erklaerung</send>
            <send id="client" type="meta">uniqueID</send>
            <send id="time" type="time" />
            <receive id="stored" append="false">rx_post_stored</receive>
            <receive id="total" append="false">rx_post_total</receive>
        </connection>
    </network>
</phyphox>
