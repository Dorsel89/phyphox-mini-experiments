            <data name="post_immer">post_immer</data>
            <data name="post_kochen">post_kochen</data>
            <data name="post_erklaerung">post_erklaerung</data>
        </set>
    </export>

    <network>
        <connection id="pretest" privacy="https://didaktik.physik.rwth-aachen.de/phyphox/api/privacy.php#umfrage" address="https://didaktik.physik.rwth-aachen.de/phyphox/api/survey_ingest.php?survey=schmelzen" autoConnect="true" service="http/post" conversion="json">
            <send id="phase" type="buffer" keep="true">phase_pre</send>
            <send id="pre_eiswasser" type="buffer" keep="true">pre_eiswasser</send>
            <send id="pre_eiswasser_sicher" type="buffer" keep="true">pre_eiswasser_sicher</send>
            <send id="pre_energie" type="buffer" keep="true">pre_energie</send>
            <send id="pre_energie_sicher" type="buffer" keep="true">pre_energie_sicher</send>
            <send id="pre_immer" type="buffer" keep="true">pre_immer</send>
            <send id="client" type="meta">uniqueID</send>
            <send id="time" type="time" />
            <receive id="stored" append="false">rx_pre_stored</receive>
            <receive id="total" append="false">rx_pre_total</receive>
        </connection>
        <connection id="posttest" privacy="https://didaktik.physik.rwth-aachen.de/phyphox/api/privacy.php#umfrage" address="https://didaktik.physik.rwth-aachen.de/phyphox/api/survey_ingest.php?survey=schmelzen" autoConnect="true" service="http/post" conversion="json">
            <send id="phase" type="buffer" keep="true">phase_post</send>
            <send id="vorhersage" type="buffer" keep="true">vorhersage</send>
            <send id="T_plateau" type="buffer" keep="true">T_plateau</send>
            <send id="t_dauer" type="buffer" keep="true">t_dauer</send>
            <send id="dT_nach" type="buffer" keep="true">dT_nach</send>
            <send id="post_eiswasser" type="buffer" keep="true">post_eiswasser</send>
            <send id="post_eiswasser_sicher" type="buffer" keep="true">post_eiswasser_sicher</send>
            <send id="post_energie" type="buffer" keep="true">post_energie</send>
            <send id="post_energie_sicher" type="buffer" keep="true">post_energie_sicher</send>
            <send id="post_immer" type="buffer" keep="true">post_immer</send>
            <send id="post_kochen" type="buffer" keep="true">post_kochen</send>
            <send id="post_erklaerung" type="buffer" keep="true">post_erklaerung</send>
            <send id="client" type="meta">uniqueID</send>
            <send id="time" type="time" />
            <receive id="stored" append="false">rx_post_stored</receive>
            <receive id="total" append="false">rx_post_total</receive>
        </connection>
    </network>
</phyphox>
